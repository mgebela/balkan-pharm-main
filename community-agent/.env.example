FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v22.0

# X / @growtoo420 — https://console.x.com → Project → App → Keys and tokens
# App permissions must be Read and Write. Bearer token alone cannot post.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=
