{
  "name": "dnevnik-live",
  "private": true,
  "scripts": {
    "firebase:login": "firebase login",
    "firebase": "firebase",
    "deploy:storage-rules-cli": "firebase deploy --only storage --project balpha-9dab9",
    "deploy:firestore-rules": "node scripts/deploy-firestore-rules.mjs",
    "deploy:firestore-indexes": "node scripts/deploy-firestore-indexes.mjs --wait",
    "check:firestore-indexes": "node scripts/deploy-firestore-indexes.mjs --dry-run",
    "deploy:storage-rules": "node scripts/deploy-storage-rules.mjs",
    "check:storage-rules": "node scripts/deploy-storage-rules.mjs --dry-run",
    "deploy:functions": "firebase deploy --only functions --project balpha-9dab9",
    "functions:install": "npm install --prefix functions",
    "pdf:investor": "python3 docs/generate_investor_pdf.py",
    "generate:token-art": "node chain/generate-token-art.js && cp shared/token-botanical-art.js app/js/token-botanical-art.js",
    "emails:push-sender": "NODE_PATH=chain/node_modules node emails/firebase/push-templates.mjs",
    "traffic:seed": "npm run traffic:seed --prefix chain",
    "traffic:day": "npm run traffic:day --prefix chain",
    "traffic:wipe": "npm run traffic:wipe --prefix chain",
    "traffic:journal": "npm run traffic:journal --prefix chain"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4"
  },
  "devDependencies": {
    "firebase-tools": "^15.24.0"
  }
}
