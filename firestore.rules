rules_version = '2';

// Dnevnik.live — Firestore security rules
// Deploy: Firebase Console → Firestore → Rules → paste & Publish
//   or: firebase deploy --only firestore:rules (requires Firebase CLI)

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function userDoc(uid) {
      return get(userPath(uid)).data;
    }

    function callerDoc() {
      return userDoc(request.auth.uid);
    }

    function normalizedRole(role) {
      return role in ['superadmin', 'supadmin']
        ? 'superadmin'
        : role;
    }

    function callerRole() {
      return signedIn() && exists(userPath(request.auth.uid))
        ? normalizedRole(callerDoc().role)
        : 'none';
    }

    function isSuperadmin() {
      return callerRole() == 'superadmin';
    }

    function isAdminOrSuper() {
      return callerRole() in ['admin', 'superadmin'];
    }

    function isPrivilegedRole(role) {
      return normalizedRole(role) in ['admin', 'superadmin'];
    }

    function hasSharedGrant(ownerUid) {
      return exists(/databases/$(database)/documents/users/$(ownerUid)/sharedGrants/$(request.auth.uid));
    }

    function selfRoleUpdateAllowed() {
      // Users may not promote themselves; allow viewer → user (hybrid bootstrap).
      return request.resource.data.role == resource.data.role
        || (resource.data.role == 'viewer' && request.resource.data.role == 'user');
    }

    function isValidSolanaPubkey(pk) {
      return pk is string
        && pk.size() >= 32
        && pk.size() <= 44;
    }

    function isValidProfileType(t) {
      return t in ['grower', 'adopter'];
    }

    function walletLinkPatchAllowed() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['solanaPubkey', 'walletProvider', 'walletLinkedAt'])
        && isValidSolanaPubkey(request.resource.data.solanaPubkey)
        && request.resource.data.walletProvider is string
        && request.resource.data.walletProvider.size() > 0
        && request.resource.data.walletProvider.size() <= 64
        && request.resource.data.walletLinkedAt is string
        && request.resource.data.walletLinkedAt.size() > 0
        // Keep identity fields stable when present
        && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)
        && (!('email' in request.resource.data) || request.resource.data.email == resource.data.email)
        && (!('profileType' in request.resource.data)
          || request.resource.data.profileType == resource.data.profileType);
    }

    // Allow clearing this account's linked wallet (disconnect).
    function walletUnlinkAllowed() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['solanaPubkey', 'walletProvider', 'walletLinkedAt'])
        && !('solanaPubkey' in request.resource.data)
        && !('walletProvider' in request.resource.data)
        && !('walletLinkedAt' in request.resource.data)
        && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)
        && (!('email' in request.resource.data) || request.resource.data.email == resource.data.email)
        && (!('profileType' in request.resource.data)
          || request.resource.data.profileType == resource.data.profileType);
    }

    // Allow setting profileType once if missing; otherwise keep it immutable.
    function profileTypeUpdateAllowed() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['profileType', 'lastLoginAt'])
        && isValidProfileType(request.resource.data.profileType)
        && (
          !('profileType' in resource.data)
          || resource.data.profileType == null
          || resource.data.profileType == ''
          || request.resource.data.profileType == resource.data.profileType
        );
    }

  // ── users ────────────────────────────────────────────────

  match /users/{userId} {
    // Own profile, admin/superadmin, or discover superadmin owner docs (shared library).
    allow read: if signedIn() && (
      request.auth.uid == userId
      || isAdminOrSuper()
      || isPrivilegedRole(resource.data.role)
    );

    allow create: if signedIn()
      && request.auth.uid == userId
      && request.resource.data.role == 'user'
      && isValidProfileType(request.resource.data.profileType);

    allow update: if signedIn() && (
      (request.auth.uid == userId && selfRoleUpdateAllowed()
        && (!('profileType' in request.resource.data)
          || request.resource.data.profileType == resource.data.profileType
          || (!('profileType' in resource.data) && isValidProfileType(request.resource.data.profileType))))
      || (request.auth.uid == userId && walletLinkPatchAllowed())
      || (request.auth.uid == userId && walletUnlinkAllowed())
      || (request.auth.uid == userId && profileTypeUpdateAllowed())
      || isSuperadmin()
    );

    allow delete: if isSuperadmin();

    // App state: plants, entries, toolbox (local-first sync)
    match /app/{docId} {
      allow read: if signedIn() && (
        request.auth.uid == userId
        || isAdminOrSuper()
        || hasSharedGrant(userId)
      );

      allow write: if signedIn() && request.auth.uid == userId;
    }

    // Superadmin shares plants/journal/tools with viewers / hybrid users
    match /sharedGrants/{viewerUid} {
      allow read: if signedIn() && (
        request.auth.uid == userId
        || request.auth.uid == viewerUid
        || isSuperadmin()
      );

      allow create: if signedIn() && (
        request.auth.uid == userId
        || isSuperadmin()
        // Hybrid bootstrap: viewer may request own grant from a superadmin owner
        || (
          request.auth.uid == viewerUid
          && isPrivilegedRole(userDoc(userId).role)
          && request.resource.data.viewerUid == viewerUid
        )
      );

      allow update, delete: if signedIn() && (
        request.auth.uid == userId
        || isSuperadmin()
      );
    }
  }

  // ── Seed NFT mint requests (M2) ──────────────────────────
  // Users file a mint request; the devnet minter (Admin SDK, bypasses
  // rules) mints the NFT and writes back mintAddress / metadataUri.

  match /seedMints/{requestId} {
    allow create: if signedIn()
      && request.resource.data.uid == request.auth.uid
      && request.resource.data.status == 'pending'
      && request.resource.data.name is string
      && request.resource.data.name.size() > 0
      && request.resource.data.name.size() <= 32
      && request.resource.data.strain is string
      && request.resource.data.strain.size() > 0
      && request.resource.data.batch is string
      && request.resource.data.batch.size() > 0
      && request.resource.data.plantId is string
      && request.resource.data.plantId.size() > 0
      && (!('recipient' in request.resource.data)
        || isValidSolanaPubkey(request.resource.data.recipient));

    allow read: if signedIn()
      && (resource.data.uid == request.auth.uid || isAdminOrSuper());

    // Only the backend minter (Admin SDK) may change status / results.
    allow update, delete: if false;
  }

  // ── Growth mint requests (M3) ────────────────────────────
  // Filed when a plant token with a real Seed NFT advances a stage.
  // Requires a linked journal plantId; the backend validates watering /
  // feeding / stage logs in users/{uid}/app/state before minting $GROW.

  match /growthMints/{requestId} {
    allow create: if signedIn()
      && request.resource.data.uid == request.auth.uid
      && request.resource.data.status == 'pending'
      && request.resource.data.mintAddress is string
      && request.resource.data.mintAddress.size() > 0
      && request.resource.data.plantId is string
      && request.resource.data.plantId.size() > 0
      && request.resource.data.stage in
        ['germination', 'seedling', 'vegetative', 'flowering', 'harvest']
      && (!('recipient' in request.resource.data)
        || isValidSolanaPubkey(request.resource.data.recipient));

    allow read: if signedIn()
      && (resource.data.uid == request.auth.uid || isAdminOrSuper());

    allow update, delete: if false;
  }

  // ── Marketplace listings (M4, devnet MVP) ────────────────
  // Seller escrows the NFT to the authority wallet, buyer pays $GROW to
  // the seller; the settlement script verifies both on-chain and moves
  // the listing through escrow_pending → active → sale_pending → sold.

  match /marketListings/{listingId} {
    // Anyone signed in can browse the market.
    allow read: if signedIn();

    allow create: if signedIn()
      && request.resource.data.uid == request.auth.uid
      && request.resource.data.status == 'escrow_pending'
      && request.resource.data.mintAddress is string
      && request.resource.data.mintAddress.size() > 0
      && isValidSolanaPubkey(request.resource.data.sellerPubkey)
      && request.resource.data.priceGrow is int
      && request.resource.data.priceGrow > 0
      && request.resource.data.name is string
      && request.resource.data.name.size() > 0
      && request.resource.data.escrowSignature is string
      && request.resource.data.escrowSignature.size() > 0;

    // Buyer claims an active listing with their payment signature…
    allow update: if signedIn() && (
      (
        resource.data.status == 'active'
        && request.resource.data.status == 'sale_pending'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'buyerUid', 'buyerPubkey', 'paymentSignature', 'investedAt'])
        && request.resource.data.buyerUid == request.auth.uid
        && isValidSolanaPubkey(request.resource.data.buyerPubkey)
        && request.resource.data.paymentSignature is string
        && request.resource.data.paymentSignature.size() > 0
        && (
          !('investedAt' in request.resource.data)
          || request.resource.data.investedAt is string
        )
      )
      // …or the seller requests a cancel while the listing is live.
      || (
        resource.data.uid == request.auth.uid
        && resource.data.status == 'active'
        && request.resource.data.status == 'cancel_requested'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
      )
    );

    allow delete: if false;
  }

  // ── Login analytics (superadmin report) ──────────────────

  match /loginEvents/{eventId} {
    allow create: if signedIn()
      && request.resource.data.uid == request.auth.uid
      && request.resource.data.keys().hasAll(['uid', 'loggedAt']);

    allow read: if isSuperadmin();

    allow update, delete: if false;
  }

  // ── Admin panel collections ──────────────────────────────

  match /plants/{docId} {
    allow read, write: if isAdminOrSuper();
  }

  match /entries/{docId} {
    allow read, write: if isAdminOrSuper();
  }

  match /tenants/{docId} {
    allow read, write: if isSuperadmin();
  }

  // Deny everything else by default
  match /{document=**} {
    allow read, write: if false;
  }
  }
}
