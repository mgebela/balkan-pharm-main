rules_version = '2';

// Dnevnik.live — Firestore security rules
// Deploy: Firebase Console → Firestore → Rules → paste & Publish
//   or: firebase deploy --only firestore:rules (requires Firebase CLI)

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function userDoc(uid) {
      return get(userPath(uid)).data;
    }

    function callerDoc() {
      return userDoc(request.auth.uid);
    }

    function normalizedRole(role) {
      return role in ['superadmin', 'supadmin']
        ? 'superadmin'
        : role;
    }

    function callerRole() {
      return signedIn() && exists(userPath(request.auth.uid))
        ? normalizedRole(callerDoc().role)
        : 'none';
    }

    function isSuperadmin() {
      return callerRole() == 'superadmin';
    }

    function isAdminOrSuper() {
      return callerRole() in ['admin', 'superadmin'];
    }

    function isPrivilegedRole(role) {
      return normalizedRole(role) in ['admin', 'superadmin'];
    }

    function hasSharedGrant(ownerUid) {
      return exists(/databases/$(database)/documents/users/$(ownerUid)/sharedGrants/$(request.auth.uid));
    }

    function selfRoleUpdateAllowed() {
      // Users may not promote themselves; allow viewer → user (hybrid bootstrap).
      return request.resource.data.role == resource.data.role
        || (resource.data.role == 'viewer' && request.resource.data.role == 'user');
    }

    function isValidSolanaPubkey(pk) {
      return pk is string
        && pk.size() >= 32
        && pk.size() <= 44;
    }

    function isValidProfileType(t) {
      return t in ['grower', 'adopter'];
    }

    function walletLinkPatchAllowed() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['solanaPubkey', 'walletProvider', 'walletLinkedAt'])
        && isValidSolanaPubkey(request.resource.data.solanaPubkey)
        && request.resource.data.walletProvider is string
        && request.resource.data.walletProvider.size() > 0
        && request.resource.data.walletProvider.size() <= 64
        && request.resource.data.walletLinkedAt is string
        && request.resource.data.walletLinkedAt.size() > 0
        // Keep identity fields stable when present
        && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)
        && (!('email' in request.resource.data) || request.resource.data.email == resource.data.email)
        && (!('profileType' in request.resource.data)
          || request.resource.data.profileType == resource.data.profileType);
    }

    // Allow clearing this account's linked wallet (disconnect).
    function walletUnlinkAllowed() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['solanaPubkey', 'walletProvider', 'walletLinkedAt'])
        && !('solanaPubkey' in request.resource.data)
        && !('walletProvider' in request.resource.data)
        && !('walletLinkedAt' in request.resource.data)
        && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)
        && (!('email' in request.resource.data) || request.resource.data.email == resource.data.email)
        && (!('profileType' in request.resource.data)
          || request.resource.data.profileType == resource.data.profileType);
    }

    // Allow setting profileType once if missing; otherwise keep it immutable.
    function profileTypeUpdateAllowed() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['profileType', 'lastLoginAt'])
        && isValidProfileType(request.resource.data.profileType)
        && (
          !('profileType' in resource.data)
          || resource.data.profileType == null
          || resource.data.profileType == ''
          || request.resource.data.profileType == resource.data.profileType
        );
    }

  // ── users ────────────────────────────────────────────────

  match /users/{userId} {
    // Own profile, admin/superadmin, or discover superadmin owner docs (shared library).
    allow read: if signedIn() && (
      request.auth.uid == userId
      || isAdminOrSuper()
      || isPrivilegedRole(resource.data.role)
    );

    allow create: if signedIn()
      && request.auth.uid == userId
      && request.resource.data.role == 'user'
      && isValidProfileType(request.resource.data.profileType);

    allow update: if signedIn() && (
      (request.auth.uid == userId && selfRoleUpdateAllowed()
        && (!('profileType' in request.resource.data)
          || request.resource.data.profileType == resource.data.profileType
          || (!('profileType' in resource.data) && isValidProfileType(request.resource.data.profileType))))
      || (request.auth.uid == userId && walletLinkPatchAllowed())
      || (request.auth.uid == userId && walletUnlinkAllowed())
      || (request.auth.uid == userId && profileTypeUpdateAllowed())
      || isSuperadmin()
    );

    allow delete: if isSuperadmin();

    // App state: plants, entries, toolbox (local-first sync)
    match /app/{docId} {
      allow read: if signedIn() && (
        request.auth.uid == userId
        || isAdminOrSuper()
        || hasSharedGrant(userId)
      );

      allow write: if signedIn() && request.auth.uid == userId;
    }

    // In-app notification inbox
    match /notifications/{notifId} {
      allow read: if signedIn() && (
        request.auth.uid == userId || isAdminOrSuper()
      );

      // Owner creates own notifications
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.type is string
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 400
        && request.resource.data.createdAt is string
        && request.resource.data.read == false;

      // Buyer may notify seller after investing (stake_received)
      allow create: if signedIn()
        && request.auth.uid != userId
        && request.resource.data.uid == userId
        && request.resource.data.type == 'stake_received'
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.createdAt is string
        && request.resource.data.read == false
        && request.resource.data.meta.listingId is string
        && exists(/databases/$(database)/documents/marketListings/$(request.resource.data.meta.listingId))
        && get(/databases/$(database)/documents/marketListings/$(request.resource.data.meta.listingId)).data.uid == userId
        && get(/databases/$(database)/documents/marketListings/$(request.resource.data.meta.listingId)).data.buyerUid == request.auth.uid
        && get(/databases/$(database)/documents/marketListings/$(request.resource.data.meta.listingId)).data.status in ['sold', 'sale_pending'];

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;

      allow delete: if signedIn() && request.auth.uid == userId;
    }

    // Superadmin shares plants/journal/tools with viewers / hybrid users
    match /sharedGrants/{viewerUid} {
      allow read: if signedIn() && (
        request.auth.uid == userId
        || request.auth.uid == viewerUid
        || isSuperadmin()
      );

      allow create: if signedIn() && (
        request.auth.uid == userId
        || isSuperadmin()
        // Hybrid bootstrap: viewer may request own grant from a superadmin owner
        || (
          request.auth.uid == viewerUid
          && isPrivilegedRole(userDoc(userId).role)
          && request.resource.data.viewerUid == viewerUid
        )
      );

      allow update, delete: if signedIn() && (
        request.auth.uid == userId
        || isSuperadmin()
      );
    }
  }

  // ── Seed NFT mint requests (M2) ──────────────────────────
  // Users file a mint request; the devnet minter (Admin SDK, bypasses
  // rules) mints the NFT and writes back mintAddress / metadataUri.

  match /seedMints/{requestId} {
    allow create: if signedIn()
      && request.resource.data.uid == request.auth.uid
      && request.resource.data.status == 'pending'
      && request.resource.data.name is string
      && request.resource.data.name.size() > 0
      && request.resource.data.name.size() <= 32
      && request.resource.data.strain is string
      && request.resource.data.strain.size() > 0
      && request.resource.data.batch is string
      && request.resource.data.batch.size() > 0
      && request.resource.data.plantId is string
      && request.resource.data.plantId.size() > 0
      && (!('recipient' in request.resource.data)
        || isValidSolanaPubkey(request.resource.data.recipient));

    allow read: if signedIn()
      && (resource.data.uid == request.auth.uid || isAdminOrSuper());

    // Only the backend minter (Admin SDK) may change status / results.
    allow update, delete: if false;
  }

  // ── Growth mint requests (M3) ────────────────────────────
  // Filed when a plant token with a real Seed NFT advances a stage.
  // Requires a linked journal plantId; the backend validates watering /
  // feeding / stage logs in users/{uid}/app/state before minting $GROW.

  match /growthMints/{requestId} {
    allow create: if signedIn()
      && request.resource.data.uid == request.auth.uid
      && request.resource.data.status == 'pending'
      && request.resource.data.mintAddress is string
      && request.resource.data.mintAddress.size() > 0
      && request.resource.data.plantId is string
      && request.resource.data.plantId.size() > 0
      && request.resource.data.stage in
        ['germination', 'seedling', 'vegetative', 'flowering', 'harvest']
      && (!('recipient' in request.resource.data)
        || isValidSolanaPubkey(request.resource.data.recipient));

    allow read: if signedIn()
      && (resource.data.uid == request.auth.uid || isAdminOrSuper());

    allow update, delete: if false;
  }

  // Consumed $GROWTOO payment tx signatures (one sig → one listing). Admin SDK only.
  match /usedPaymentSignatures/{signature} {
    allow read, create, update, delete: if false;
  }

  function isPendingPaymentSig(sig) {
    return sig is string
      && sig.size() >= 8
      && sig[0:8] == 'pending-';
  }

  // Real payment sigs must not already be reserved/consumed by another listing.
  function paymentSigAvailable(sig) {
    return isPendingPaymentSig(sig)
      || !exists(/databases/$(database)/documents/usedPaymentSignatures/$(sig));
  }

  // ── Marketplace listings (M4, devnet MVP) ────────────────
  // Legacy: seller escrows NFT to hot wallet; CF/queue settles.
  // Program: seller locks NFT into growtoo_escrow PDA; buy/cancel are atomic.

  match /marketListings/{listingId} {
    // Full listing docs (uids, wallets, sigs, journal snippets) — signed-in only.
    // Landing ticker reads scrubbed `marketPublicTape` (public, field-limited).
    allow read: if signedIn();

    allow create: if signedIn()
      && request.resource.data.uid == request.auth.uid
      && isValidSolanaPubkey(request.resource.data.sellerPubkey)
      && request.resource.data.mintAddress is string
      && request.resource.data.mintAddress.size() > 0
      && request.resource.data.priceGrow is int
      && request.resource.data.priceGrow > 0
      && request.resource.data.name is string
      && request.resource.data.name.size() > 0
      // Block private journal / photo payloads on the shared listing doc.
      && !('journalSnippets' in request.resource.data)
      && !('photo' in request.resource.data)
      && (
        // Legacy hot-wallet escrow path
        (
          request.resource.data.status == 'escrow_pending'
          && request.resource.data.escrowSignature is string
          && request.resource.data.escrowSignature.size() > 0
          && (
            !('settlement' in request.resource.data)
            || request.resource.data.settlement == 'legacy'
          )
        )
        // Adopt stake: NFT escrow + 50/50 $GROWTOO care lock (queue-settled)
        || (
          request.resource.data.status == 'escrow_pending'
          && request.resource.data.settlement == 'adopt_stake'
          && request.resource.data.escrowSignature is string
          && request.resource.data.escrowSignature.size() > 0
          && request.resource.data.stakeLockedBps == 5000
          && request.resource.data.careEscrowAddress is string
          && isValidSolanaPubkey(request.resource.data.careEscrowAddress)
          && request.resource.data.totalGrow is int
          && request.resource.data.immediateGrow is int
          && request.resource.data.lockedGrow is int
          && request.resource.data.totalGrow == request.resource.data.priceGrow
          && request.resource.data.immediateGrow + request.resource.data.lockedGrow
            == request.resource.data.totalGrow
        )
        // On-chain program escrow path (already active after list ix)
        || (
          request.resource.data.status == 'active'
          && request.resource.data.settlement == 'program'
          && request.resource.data.listingPda is string
          && request.resource.data.listingPda.size() > 0
          && request.resource.data.listSignature is string
          && request.resource.data.listSignature.size() > 0
          && request.resource.data.escrowSignature is string
          && request.resource.data.escrowSignature.size() > 0
        )
      );

    // Buyer claims an active listing with their payment signature…
    allow update: if signedIn() && (
      (
        resource.data.status == 'active'
        && request.resource.data.status == 'sale_pending'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'buyerUid', 'buyerPubkey', 'paymentSignature', 'investedAt'])
        && request.resource.data.buyerUid == request.auth.uid
        && isValidSolanaPubkey(request.resource.data.buyerPubkey)
        && request.resource.data.paymentSignature is string
        && request.resource.data.paymentSignature.size() > 0
        && paymentSigAvailable(request.resource.data.paymentSignature)
        && (
          !('investedAt' in request.resource.data)
          || request.resource.data.investedAt is string
        )
      )
      // Buyer attaches the real payment signature after a pre-pay reservation.
      || (
        resource.data.status == 'sale_pending'
        && resource.data.buyerUid == request.auth.uid
        && request.resource.data.status == 'sale_pending'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['paymentSignature', 'investedAt'])
        && resource.data.paymentSignature is string
        && resource.data.paymentSignature.size() >= 8
        && resource.data.paymentSignature[0:8] == 'pending-'
        && request.resource.data.paymentSignature is string
        && request.resource.data.paymentSignature.size() > 0
        && request.resource.data.paymentSignature[0:8] != 'pending-'
        && paymentSigAvailable(request.resource.data.paymentSignature)
        && (
          !('investedAt' in request.resource.data)
          || request.resource.data.investedAt is string
        )
      )
      // Buyer releases an unpaid reservation (pay failed / abandoned).
      || (
        resource.data.status == 'sale_pending'
        && resource.data.buyerUid == request.auth.uid
        && request.resource.data.status == 'active'
        && resource.data.paymentSignature is string
        && resource.data.paymentSignature.size() >= 8
        && resource.data.paymentSignature[0:8] == 'pending-'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'buyerUid', 'buyerPubkey', 'paymentSignature', 'investedAt'])
        && !('buyerUid' in request.resource.data)
        && !('buyerPubkey' in request.resource.data)
        && !('paymentSignature' in request.resource.data)
        && !('investedAt' in request.resource.data)
      )
      // Program path: buyer completes atomic buy → sold
      || (
        resource.data.status == 'active'
        && resource.data.settlement == 'program'
        && request.resource.data.status == 'sold'
        && request.resource.data.buyerUid == request.auth.uid
        && isValidSolanaPubkey(request.resource.data.buyerPubkey)
        && request.resource.data.paymentSignature is string
        && request.resource.data.paymentSignature.size() > 0
        && paymentSigAvailable(request.resource.data.paymentSignature)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'status',
            'buyerUid',
            'buyerPubkey',
            'paymentSignature',
            'buySignature',
            'investedAt',
            'soldAt'
          ])
      )
      // …or the seller requests a cancel while the listing is live (legacy).
      || (
        resource.data.uid == request.auth.uid
        && resource.data.status == 'active'
        && request.resource.data.status == 'cancel_requested'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'cancelRequestedAt'])
        && (
          !('cancelRequestedAt' in request.resource.data)
          || request.resource.data.cancelRequestedAt is string
        )
      )
      // Program path: seller cancels atomically → cancelled
      || (
        resource.data.uid == request.auth.uid
        && resource.data.status == 'active'
        && resource.data.settlement == 'program'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'cancelSignature', 'cancelledAt'])
      )
    );

    allow delete: if false;
  }

  // ── Public market tape (landing page, no auth) ─────────────
  // Written only by Admin SDK (onMarketListingHealth). Deliberately scrubbed:
  // name/price/status/stage/mint — never uids, wallets, sigs, journal, photos.

  match /marketPublicTape/{listingId} {
    allow read: if true;
    allow create, update, delete: if false;
  }

  // ── Adopt-stake harvest claims (locked 50% release / refund) ──

  match /harvestClaims/{claimId} {
    allow read: if signedIn()
      && (resource.data.uid == request.auth.uid || isAdminOrSuper());

    allow create: if signedIn()
      && request.resource.data.uid == request.auth.uid
      && request.resource.data.status == 'pending'
      && request.resource.data.listingId is string
      && request.resource.data.listingId.size() > 0
      && request.resource.data.keys().hasAll(['uid', 'listingId', 'status', 'requestedAt']);

    // Retry after a failed settle
    allow update: if signedIn()
      && resource.data.uid == request.auth.uid
      && resource.data.status == 'failed'
      && request.resource.data.status == 'pending'
      && request.resource.data.uid == request.auth.uid
      && request.resource.data.listingId == resource.data.listingId;

    allow delete: if false;
  }

  // Mirror docs written by adopt-stake worker (read-only for clients)

  match /adoptStakes/{stakeId} {
    allow read: if signedIn()
      && (
        resource.data.sellerUid == request.auth.uid
        || resource.data.buyerUid == request.auth.uid
        || resource.data.uid == request.auth.uid
        || isAdminOrSuper()
      );
    allow create, update, delete: if false;
  }

  // ── Platform monthly $GROWTOO bonus (UA / marketing) ──

  match /platformRewards/{rewardId} {
    allow read: if signedIn()
      && (resource.data.uid == request.auth.uid || isAdminOrSuper());

    allow create: if signedIn()
      && request.resource.data.uid == request.auth.uid
      && request.resource.data.status == 'pending'
      && request.resource.data.monthKey is string
      && request.resource.data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
      && isValidSolanaPubkey(request.resource.data.recipient)
      && request.resource.data.keys().hasAll(['uid', 'monthKey', 'recipient', 'status', 'requestedAt'])
      && (
        !('source' in request.resource.data)
        || request.resource.data.source == 'platform'
        || (
          request.resource.data.source == 'adopter_faucet'
          && request.resource.data.dayKey is string
          && request.resource.data.dayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.amount is number
          && request.resource.data.amount >= 1
          && request.resource.data.amount <= 500
        )
      );

    allow update: if signedIn()
      && resource.data.uid == request.auth.uid
      && resource.data.status == 'failed'
      && request.resource.data.status == 'pending'
      && request.resource.data.uid == request.auth.uid
      && request.resource.data.monthKey == resource.data.monthKey
      && isValidSolanaPubkey(request.resource.data.recipient);

    allow delete: if false;
  }

  // ── Login analytics (superadmin report) ──────────────────

  match /loginEvents/{eventId} {
    allow create: if signedIn()
      && request.resource.data.uid == request.auth.uid
      && request.resource.data.keys().hasAll(['uid', 'loggedAt']);

    allow read: if isSuperadmin();

    allow update, delete: if false;
  }

  // ── Admin panel collections ──────────────────────────────

  match /plants/{docId} {
    allow read, write: if isAdminOrSuper();
  }

  match /entries/{docId} {
    allow read, write: if isAdminOrSuper();
  }

  match /tenants/{docId} {
    allow read, write: if isSuperadmin();
  }

  // Ops: written only by Admin SDK (Cloud Functions). Superadmin can read.
  match /opsHealthEvents/{eventId} {
    allow read: if isSuperadmin();
    allow write: if false;
  }

  // Deny everything else by default
  match /{document=**} {
    allow read, write: if false;
  }
  }
}
