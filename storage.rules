rules_version = '2';

// Journal photos for growtoo.
//
// Photos used to be base64 data URIs inlined into users/{uid}/app/state. That
// document has a hard 1 MiB Firestore ceiling, and roughly nine attachments
// were enough to cross it and silently kill cloud backup for that account.
// Photos now live here instead; the journal document keeps only a URL.
//
// A grow journal is private by default, so nothing here is world-readable —
// each grower reads and writes only their own prefix.
service firebase.storage {
  match /b/{bucket}/o {

    match /users/{uid}/journal/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // Cap per object as well as by type. The client compresses before
      // upload; this is the backstop for a client that does not.
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Anything outside a grower's own journal prefix is closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
